# Rust / Cargo
/target/
**/*.rs.bk

# Local secrets and runtime config
.env
.env.*
!.env.example

# TLS keys and dev certificates (generate locally)
/certs/
*.pem
*.key
*.crt
!**/.gitkeep

# Blocklace persistence
/data/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Benchmark reports (regenerated by `cargo bench`)
target/criterion/

# LaTeX build artifacts (optional local PDF builds)
docs/**/*.aux
docs/**/*.log
docs/**/*.out
docs/**/*.toc
docs/**/*.bbl
docs/**/*.blg
docs/**/*.fls
docs/**/*.fdb_latexmk
docs/**/*.synctex.gz
docs/**/*.pdf
