# FSTP Sync Agent — copy to .env and edit before running.
# Never commit .env or production secrets.

# ── Node identity ────────────────────────────────────────────────────────────

# Seed for CII derivation via HKDF-SHA256 (Property 3.1).
# Production: derive from the node's DID private key bytes (32+ bytes).
FSTP_NODE_IKM=change-me-32-bytes-minimum-secret!!

FSTP_NODE_DID=did:key:local-dev-node
# SA listens here (HTTPS). Do NOT share 8080 with sos-backend (see Network below).
FSTP_OWN_URL=https://localhost:8080
FSTP_ROOT_LINK_ID=00000000-0000-0000-0000-000000000000

# ── Network ───────────────────────────────────────────────────────────────────
# Port 8080 = fstp-agent (SA). Velyzor Spring Boot must use another port (e.g. 8081):
#   SERVER_PORT=8081 ./gradlew bootRunFstpStaging  (from sos-backend)
#   BASE_URL=http://localhost:8081 ./scripts/smoke-p1-fstp.sh
# Alternative: keep BE on 8080 and set FSTP_HTTP_ADDR=0.0.0.0:18443 + update POD_AGENT_BASE_URL.

FSTP_HTTP_ADDR=0.0.0.0:8080
FSTP_GRPC_ADDR=127.0.0.1:50051

# ── TLS (generate under certs/ locally; directory is gitignored) ─────────────

FSTP_CERT_PATH=certs/server.crt
FSTP_KEY_PATH=certs/server.key
FSTP_CLIENT_CA_PATH=certs/ca.crt
# Strict mTLS: reject TLS handshakes without a client cert (auto-on when FSTP_PROFILE=production).
# FSTP_REQUIRE_CLIENT_CERT=true

# ── Encrypted pod (AGR-101 / F01-1) ───────────────────────────────────────────
# Institutional data at rest: pod/, config/, keys/ under VELYZOR_POD_ROOT.
# Linux desktop default: ~/.local/share/agora-desktop/

# VELYZOR_POD_ROOT=/var/lib/velizor-sync
FSTP_POD_PASSPHRASE=change-me-in-production

# First deploy in production: FSTP_POD_AUTO_INIT=1 (once), then remove.
# FSTP_POD_AUTO_INIT=1

# Legacy plaintext snapshot (migrated once into pod if present):
# FSTP_BLOCKLACE_PATH=data/blocklace.json

# ── Phase 2 — trusted issuers for verify-credential (JSON array) ───────────
# Use single quotes so inner double-quotes parse correctly. After smoke step [7], paste the line it prints.
# FSTP_TRUSTED_ISSUERS_JSON='[{"did":"did:key:issuer","pubkeyHex":"<64 hex>"}]'

# Dev only: accept caller-supplied pubkey when DID is not in registry
# FSTP_GRPC_TRUST_CALLER_PUBKEY=true

# Optional: notify a platform after federated present-credential
# FSTP_VELYZOR_BASE_URL=http://localhost:8081
# Legacy: FSTP_AGORA_BASE_URL=http://localhost:8081
# FSTP_VELYZOR_SOCKET_PATH=/tmp/velizor-sync/agent.sock
# Legacy: FSTP_AGORA_SOCKET_PATH=/tmp/agora-sync/agent.sock
# FSTP_POD_AGENT_KEY=dev-pod-agent-key

FSTP_CONTRACT_VERSION=1.0.0

# ── Production profile (IP-02) — aborts startup if dev flags are set ────────

# FSTP_PROFILE=production

# ── Phase 3 — Velyzor platform routes (X-Pod-Agent-Key) ───────────────────────

FSTP_POD_AGENT_KEY=dev-pod-agent-key

# Dev only — NEVER set in production (see docs/MTLS-PRODUCTION.md)
# P3 Pod↔Pod smoke (loopback present-credential on one SA):
FSTP_DEV_INSECURE_OUTBOUND=true
FSTP_DEV_TRUST_PRESENT_CREDENTIAL=true
# Same SA for alpha+beta: skip outbound HTTPS self-call (auto when INSECURE_OUTBOUND=true)
# FSTP_DEV_LOOPBACK_PRESENT=true
# FSTP_GRPC_TRUST_CALLER_PUBKEY=true

# ── Phase 4 — periodic Blocklace sync (seconds, min 30) ─────────────────────

# FSTP_SYNC_INTERVAL_SECS=300
